{
  "realm": "lotou",
  "displayName": "Lotou",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "pt-BR"
  ],
  "defaultLocale": "pt-BR",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "roles": {
    "realm": [
      {
        "name": "buyer",
        "description": "Comprador: compra ingressos na loja e acompanha seus pedidos"
      },
      {
        "name": "producer",
        "description": "Produtor: cria shows e acompanha vendas, portaria e financeiro"
      },
      {
        "name": "gate-staff",
        "description": "Portaria: lê o QR code dos ingressos na entrada do show"
      },
      {
        "name": "service",
        "description": "Conta de serviço: chamada entre serviços do Lotou, sem usuário"
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-lotou",
    "description": "Papéis de quem se cadastra pela loja",
    "composite": true,
    "composites": {
      "realm": [
        "buyer"
      ]
    }
  },
  "clientScopes": [
    {
      "name": "lotou-api",
      "description": "Marca o token como destinado à API do Lotou e expõe os papéis do realm",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "audience-lotou-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "lotou-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "name": "basic",
      "description": "Claims básicos do token: sub e auth_time. Um realm importado com clientScopes não ganha os escopos padrão do Keycloak, então eles são declarados aqui",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "auth_time",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "config": {
            "user.session.note": "AUTH_TIME",
            "claim.name": "auth_time",
            "jsonType.label": "long",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "profile",
      "description": "Nome do usuário, para a loja cumprimentar quem entrou. Vai só no id token e no userinfo, não no token de acesso",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "given name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "firstName",
            "claim.name": "given_name",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "family name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "lastName",
            "claim.name": "family_name",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "full name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-full-name-mapper",
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "lotou-web",
      "name": "Lotou (loja, painel e portaria)",
      "description": "Aplicação Angular. Cliente público: autentica com Authorization Code + PKCE",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "rootUrl": "http://localhost:4200",
      "baseUrl": "/",
      "redirectUris": [
        "http://localhost:4200/*"
      ],
      "webOrigins": [
        "http://localhost:4200"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*"
      },
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "basic",
        "profile",
        "lotou-api"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "lotou-seed",
      "name": "Lotou seed",
      "description": "Carga de dados fictícios, só para desenvolvimento. Cliente confidencial: o seed entra como o produtor de demonstração (fluxo de senha) e os testes de carga usam a conta de serviço (client credentials)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "lotou-seed-dev-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "basic",
        "lotou-api"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "order-service",
      "name": "Lotou order-service",
      "description": "Conta de serviço do order-service: lê as reservas no inventory-service",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "order-service-dev-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "basic",
        "lotou-api"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "lotou-smoke",
      "name": "Lotou smoke",
      "description": "Verificação do ambiente: faz uma compra de ponta a ponta como comprador",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "lotou-smoke-dev-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "basic",
        "lotou-api"
      ],
      "optionalClientScopes": []
    }
  ],
  "scopeMappings": [
    {
      "clientScope": "lotou-api",
      "roles": [
        "buyer",
        "producer",
        "gate-staff",
        "service"
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-lotou-seed",
      "enabled": true,
      "serviceAccountClientId": "lotou-seed",
      "realmRoles": [
        "producer"
      ]
    },
    {
      "username": "service-account-order-service",
      "enabled": true,
      "serviceAccountClientId": "order-service",
      "realmRoles": [
        "service"
      ]
    },
    {
      "username": "service-account-lotou-smoke",
      "enabled": true,
      "serviceAccountClientId": "lotou-smoke",
      "realmRoles": [
        "buyer"
      ]
    },
    {
      "username": "comprador",
      "email": "comprador@lotou.test",
      "emailVerified": true,
      "firstName": "Bia",
      "lastName": "Compradora",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "lotou123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "buyer"
      ]
    },
    {
      "username": "produtor",
      "email": "produtor@lotou.test",
      "emailVerified": true,
      "firstName": "Caio",
      "lastName": "Produtor",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "lotou123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "producer"
      ]
    },
    {
      "username": "portaria",
      "email": "portaria@lotou.test",
      "emailVerified": true,
      "firstName": "Duda",
      "lastName": "Portaria",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "lotou123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "gate-staff"
      ]
    }
  ]
}
