    {
      "type": "stat",
      "title": "Invariantes de venda violadas",
      "description": "Lote ou setor com mais reservas ativas que ingressos, ou cadeira em duas reservas. Tem que ser zero.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pg-inventory"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pg-inventory"
          },
          "rawSql": "SELECT\n  (SELECT count(*) FROM (SELECT l.id FROM lots l JOIN reservation_items i ON i.lot_id = l.id\n     JOIN reservations r ON r.id = i.reservation_id AND r.status IN ('HELD', 'CONFIRMED')\n     GROUP BY l.id, l.quantity HAVING count(*) > l.quantity) a)\n+ (SELECT count(*) FROM (SELECT s.id FROM sectors s\n     JOIN reservations r ON r.show_id = s.show_id AND r.sector_id = s.id AND r.status IN ('HELD', 'CONFIRMED')\n     GROUP BY s.id, s.capacity HAVING sum(r.quantity) > s.capacity) b)\n+ (SELECT count(*) FROM (SELECT i.seat_id FROM reservation_items i\n     JOIN reservations r ON r.id = i.reservation_id AND r.status IN ('HELD', 'CONFIRMED')\n     WHERE i.seat_id IS NOT NULL GROUP BY i.seat_id HAVING count(*) > 1) c) AS violacoes",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
