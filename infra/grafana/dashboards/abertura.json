    {
      "type": "table",
      "title": "Ingressos restantes por lote (shows com vendas abertas)",
      "description": "Lido do Postgres do inventory. No motor Redis, o Postgres recebe as reservas pelo stream, com alguns milissegundos de atraso.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pg-inventory"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pg-inventory"
          },
          "rawSql": "\nSELECT left(l.show_id::text, 8) AS show, s.name AS setor, l.name AS lote, l.status,\n       l.available AS restantes, l.quantity AS total,\n       round(100.0 * (l.quantity - l.available) / nullif(l.quantity, 0), 1) AS \"vendido (%)\"\nFROM lots l\nJOIN sectors s ON s.show_id = l.show_id AND s.id = l.sector_id\nJOIN shows sh ON sh.id = l.show_id\nWHERE sh.status = 'ON_SALE' AND l.status <> 'SCHEDULED'\nORDER BY sh.starts_at, s.position, l.position",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
