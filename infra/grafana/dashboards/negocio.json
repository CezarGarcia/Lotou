    {
      "type": "table",
      "title": "Vendas por show",
      "description": "Do Postgres do order-service. Receita = ingressos menos desconto dos pedidos que valem (sem a taxa e sem os reembolsados).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pg-orders"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pg-orders"
          },
          "rawSql": "\nSELECT s.title AS show, s.status, s.service_fee_paid_by AS \"taxa paga por\",\n       count(*) FILTER (WHERE o.confirmed_at IS NOT NULL) AS confirmados,\n       count(*) FILTER (WHERE o.status = 'REFUNDED') AS reembolsados,\n       count(*) FILTER (WHERE o.coupon_id IS NOT NULL AND o.confirmed_at IS NOT NULL) AS \"com cupom\",\n       round(sum(o.subtotal_cents - o.discount_cents) FILTER (WHERE o.status IN ('CONFIRMED', 'REFUNDING', 'REFUND_FAILED')) / 100.0, 2) AS \"receita (R$)\"\nFROM shows s\nJOIN orders o ON o.show_id = s.id\nGROUP BY s.id, s.title, s.status, s.service_fee_paid_by\nORDER BY confirmados DESC",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "id": 12
    },
    {
      "type": "table",
      "title": "Cupons",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pg-orders"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pg-orders"
          },
          "rawSql": "\nSELECT s.title AS show, c.code AS cupom, c.kind AS tipo, coalesce(c.percent::text || '%', round(c.amount_cents / 100.0, 2)::text) AS desconto,\n       c.uses AS usos, c.max_uses AS limite, c.status, c.valid_until AS \"válido até\"\nFROM coupons c JOIN shows s ON s.id = c.show_id\nORDER BY c.created_at DESC LIMIT 50",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
