{
  "uid": "lotou-redis",
  "title": "Redis e cache",
  "description": "Taxa de acerto do cache da página do show, memória, evictions e comandos nos dois Redis (ADR 10).",
  "tags": [
    "lotou"
  ],
  "timezone": "browser",
  "editable": false,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "10s",
