    {
      "type": "table",
      "title": "Ocupação por show (shows de hoje e próximos)",
      "description": "Da cópia local do checkin-service.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pg-checkin"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pg-checkin"
          },
          "rawSql": "\nSELECT s.title AS show, s.venue_name AS local, s.starts_at AS \"começa\",\n       count(DISTINCT c.ticket_id) AS entradas,\n       count(DISTINCT v.ticket_id) FILTER (WHERE v.status <> 'CANCELLED') AS ingressos,\n       round(100.0 * count(DISTINCT c.ticket_id)\n             / nullif(count(DISTINCT v.ticket_id) FILTER (WHERE v.status <> 'CANCELLED'), 0), 1) AS \"ocupação (%)\"\nFROM shows s\nLEFT JOIN valid_tickets v ON v.show_id = s.show_id\nLEFT JOIN checkins c ON c.show_id = s.show_id\nWHERE s.starts_at > now() - interval '1 day' AND s.starts_at < now() + interval '3 days'\nGROUP BY s.show_id, s.title, s.venue_name, s.starts_at\nORDER BY s.starts_at",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
