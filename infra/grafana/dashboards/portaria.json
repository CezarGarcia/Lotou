    {
      "type": "table",
      "title": "Últimos conflitos da portaria offline",
      "description": "Do Postgres do checkin-service. A primeira entrada (pelo horário da leitura) vale; as outras ficam aqui.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pg-checkin"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pg-checkin"
          },
          "rawSql": "\nSELECT c.detected_at AS detectado, s.title AS show, c.kind AS tipo, c.gate AS \"portão\", left(c.device_id::text, 8) AS aparelho,\n       c.scanned_at AS lido, c.first_gate AS \"entrou antes por\", c.first_checked_in_at AS \"entrou antes às\",\n       left(c.ticket_id::text, 8) AS ingresso\nFROM offline_conflicts c\nLEFT JOIN shows s ON s.show_id = c.show_id\nORDER BY c.detected_at DESC\nLIMIT 50",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "gridPos": {
