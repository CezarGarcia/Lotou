    {
      "type": "timeseries",
      "title": "Geração de PDF",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(tickets_rendered_total[$__rate_interval]))",
          "legendFormat": "ingressos renderizados/s",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(ticket_render_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95 da renderização (s)",
          "range": true,
          "instant": false
