            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (rabbitmq_queue_name) (rabbitmq_message_current{state=\"ready\",rabbitmq_queue_name!=\"\",rabbitmq_queue_name!~\".+\\\\.dlq\"})",
          "legendFormat": "{{rabbitmq_queue_name}}",
