# Servidor da loja. As variáveis ${...} são preenchidas na subida do container
# (a imagem oficial do nginx aplica envsubst nos arquivos de /etc/nginx/templates).
#
# A loja, a API e o envio de telemetria ficam no mesmo domínio: o navegador não
# precisa de CORS, e o cabeçalho traceparent segue junto com cada chamada.

# Cabeçalho Connection para o WebSocket: "upgrade" quando o navegador pede a
# troca de protocolo, "close" nas demais requisições.
map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  gzip on;
  gzip_min_length 1024;
  gzip_types text/css application/javascript application/json image/svg+xml;

  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;

  # API: tudo passa pelo gateway. O X-Forwarded-For leva o IP do comprador,
  # que o rate limit do gateway usa.
  location /api/ {
    proxy_pass ${API_GATEWAY_URL};
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }

  # Fluxos SSE da API (fila virtual e mapa de cadeiras: /api/.../events).
  # Cada evento tem que chegar na hora: sem buffer, sem compressão e com a
  # conexão aberta por muito tempo (o servidor manda heartbeats).
  location ~ ^/api/.+/events$ {
    proxy_pass ${API_GATEWAY_URL};
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 1h;
    gzip off;
  }

  # WebSocket do painel ao vivo (ADR 17). O nginx só repassa o Upgrade ao
  # gateway; quem autentica é o analytics, na primeira mensagem. A conexão fica
  # aberta enquanto o painel estiver na tela: o servidor manda ping a cada 20 s
  # e métricas a cada segundo, então 1 hora sem nada é conexão morta.
  location = /api/v1/analytics/live {
    proxy_pass ${API_GATEWAY_URL};
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_buffering off;
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
  }

  # Traces do navegador: /otlp/v1/traces -> Collector /v1/traces.
  location /otlp/ {
    proxy_pass ${OTEL_COLLECTOR_URL}/;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    client_max_body_size 2m;
  }

  # Arquivos com hash no nome nunca mudam: cache longo.
  location ~* "-[A-Za-z0-9_-]{8}\.(?:js|css)$" {
    expires 1y;
    try_files $uri =404;
  }

  # O index.html aponta para os arquivos com hash: sempre revalidado.
  location = /index.html {
    expires -1;
  }

  # PWA (ADR 37): o service worker e a lista de arquivos dele dizem qual versão
  # da loja o aparelho guarda. Sempre revalidados, para uma versão nova chegar.
  location ~ ^/(ngsw-worker\.js|ngsw\.json|safety-worker\.js|worker-basic\.min\.js)$ {
    add_header Cache-Control "no-cache" always;
    add_header X-Content-Type-Options "nosniff" always;
    try_files $uri =404;
  }

  # O manifesto do PWA tem um tipo próprio, que o mime.types do nginx não traz.
  location = /manifest.webmanifest {
    types { }
    default_type application/manifest+json;
    add_header Cache-Control "no-cache" always;
    add_header X-Content-Type-Options "nosniff" always;
  }

  # Rotas do Angular (/shows/:id) caem no index.html.
  location / {
    try_files $uri $uri/ /index.html;
  }
}
