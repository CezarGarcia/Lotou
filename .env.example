# Copie para .env para trocar as credenciais do ambiente local.
# Sem o arquivo .env, o Compose usa os valores abaixo.

POSTGRES_USER=lotou
POSTGRES_PASSWORD=lotou
KEYCLOAK_DB_PASSWORD=keycloak
INVENTORY_DB_PASSWORD=inventory
ORDERS_DB_PASSWORD=orders
PAYMENTS_DB_PASSWORD=payments
CHECKIN_DB_PASSWORD=checkin
# Usuário só de leitura do Collector e do Grafana.
OBSERVER_DB_PASSWORD=observer

# Chave do HMAC que transforma o CPF em hash no inventory-service.
CPF_HASH_KEY=lotou-dev-cpf-hash-key

# QR code dos ingressos (ADR 38): o order-service assina com a chave privada Ed25519 (PKCS#8 em
# base64) e a portaria confere com a pública (SPKI em base64), inclusive no aparelho, sem internet.
TICKET_SIGNING_KEY=MC4CAQAwBQYDK2VwBCIEIC1xlzooL1BoE6E6a9LUogLZURUHkdtAlFUsRX3GPlKc
# Chave do HMAC dos ingressos antigos (LOTOU1), que a portaria ainda aceita.
TICKET_QR_KEY=lotou-dev-ticket-qr-key

# Fração dos pagamentos recusados e dos estornos que falham no payment-mock (0 a 1).
# O experimento de caos usa PAYMENT_MOCK_DECLINE_RATE=0.3.
PAYMENT_MOCK_DECLINE_RATE=0
PAYMENT_MOCK_REFUND_FAILURE_RATE=0

RABBITMQ_USER=lotou
RABBITMQ_PASSWORD=lotou

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Segredo do cliente usado pelo seed (o mesmo de infra/keycloak/lotou-realm.json).
SEED_CLIENT_SECRET=lotou-seed-dev-secret

# Segredo da conta de serviço do notification-service (o mesmo do realm), que lê o
# e-mail do comprador no Keycloak.
NOTIFICATION_CLIENT_SECRET=notification-service-dev-secret

# Processos que geram os PDFs dos ingressos no notification-service.
NOTIFICATION_RENDER_WORKERS=2

# Porcentagem dos traces rápidos e sem erro guardados no Tempo (os com erro ou lentos vão todos). 100 guarda tudo.
TRACE_SAMPLE_PERCENT=10
