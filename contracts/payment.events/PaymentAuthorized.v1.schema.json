{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lotou:contracts:payment.events:PaymentAuthorized:v1",
  "title": "PaymentAuthorized v1",
  "description": "Pagamento aprovado. Tópico `payment.events`, chave `orderId`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "type",
    "version",
    "occurredAt",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "UUID v7 da mensagem; o consumidor o usa para ignorar repetições"
    },
    "type": {
      "const": "PaymentAuthorized"
    },
    "version": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orderId",
        "paymentId",
        "amountCents",
        "authorizedAt"
      ],
      "properties": {
        "orderId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "paymentId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "amountCents": {
          "type": "integer",
          "minimum": 0
        },
        "authorizedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
