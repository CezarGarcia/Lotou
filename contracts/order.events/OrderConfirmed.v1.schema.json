{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lotou:contracts:order.events:OrderConfirmed:v1",
  "title": "OrderConfirmed v1",
  "description": "Pagamento aprovado e reserva confirmada: o pedido está pago. Tópico `order.events`, chave `orderId`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "type",
    "version",
    "occurredAt",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "UUID v7 da mensagem; o consumidor o usa para ignorar repetições"
    },
    "type": {
      "const": "OrderConfirmed"
    },
    "version": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orderId",
        "buyerId",
        "showId",
        "reservationId",
        "totalCents",
        "items",
        "confirmedAt"
      ],
      "properties": {
        "orderId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "buyerId": {
          "type": "string",
          "minLength": 1
        },
        "showId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "reservationId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "totalCents": {
          "type": "integer",
          "minimum": 0
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sectorId",
              "sectorName",
              "lotId",
              "lotName",
              "seat",
              "unitPriceCents"
            ],
            "properties": {
              "sectorId": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "sectorName": {
                "type": "string",
                "minLength": 1
              },
              "lotId": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "lotName": {
                "type": "string",
                "minLength": 1
              },
              "seat": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Rótulo da cadeira (A-12); null na pista"
              },
              "unitPriceCents": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "minItems": 1
        },
        "confirmedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
