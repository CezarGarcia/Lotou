{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lotou:contracts:order.events:OrderCreated:v1",
  "title": "OrderCreated v1",
  "description": "Pedido criado a partir de uma reserva; o pagamento ainda vai ser autorizado. Tópico `order.events`, chave `orderId`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "type",
    "version",
    "occurredAt",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "UUID v7 da mensagem; o consumidor o usa para ignorar repetições"
    },
    "type": {
      "const": "OrderCreated"
    },
    "version": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orderId",
        "buyerId",
        "showId",
        "reservationId",
        "totalCents",
        "items",
        "createdAt",
        "subtotalCents",
        "discountCents",
        "serviceFeeCents",
        "serviceFeePaidBy",
        "couponId",
        "couponCode"
      ],
      "properties": {
        "orderId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "buyerId": {
          "type": "string",
          "minLength": 1
        },
        "showId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "reservationId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "totalCents": {
          "type": "integer",
          "minimum": 0,
          "description": "valor cobrado do comprador: subtotal − desconto + taxa (quando o comprador paga a taxa)"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sectorId",
              "sectorName",
              "lotId",
              "lotName",
              "seat",
              "unitPriceCents"
            ],
            "properties": {
              "sectorId": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "sectorName": {
                "type": "string",
                "minLength": 1
              },
              "lotId": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "lotName": {
                "type": "string",
                "minLength": 1
              },
              "seat": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Rótulo da cadeira (A-12); null na pista"
              },
              "unitPriceCents": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "minItems": 1
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "subtotalCents": {
          "type": "integer",
          "minimum": 0,
          "description": "soma dos ingressos, ao preço da reserva"
        },
        "discountCents": {
          "type": "integer",
          "minimum": 0,
          "description": "desconto do cupom, só sobre os ingressos"
        },
        "serviceFeeCents": {
          "type": "integer",
          "minimum": 0,
          "description": "taxa de serviço de 10% sobre os ingressos"
        },
        "serviceFeePaidBy": {
          "enum": [
            "BUYER",
            "PRODUCER"
          ],
          "description": "Quem paga a taxa de serviço de 10%: o comprador (somada ao total) ou o produtor (descontada do valor a receber)"
        },
        "couponId": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "description": "cupom aplicado, ou null"
        },
        "couponCode": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
