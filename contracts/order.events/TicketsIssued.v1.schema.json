{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lotou:contracts:order.events:TicketsIssued:v1",
  "title": "TicketsIssued v1",
  "description": "Ingressos emitidos para um pedido confirmado. Tópico `order.events`, chave `orderId`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "type",
    "version",
    "occurredAt",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "UUID v7 da mensagem; o consumidor o usa para ignorar repetições"
    },
    "type": {
      "const": "TicketsIssued"
    },
    "version": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orderId",
        "buyerId",
        "showId",
        "tickets",
        "issuedAt"
      ],
      "properties": {
        "orderId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "buyerId": {
          "type": "string",
          "minLength": 1
        },
        "showId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "tickets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ticketId",
              "sectorId",
              "sectorName",
              "seat",
              "code"
            ],
            "properties": {
              "ticketId": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "sectorId": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "sectorName": {
                "type": "string",
                "minLength": 1
              },
              "seat": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "code": {
                "type": "string",
                "pattern": "^(LOTOU2\\.[0-9a-f-]{36}\\.[A-Za-z0-9_-]{86}|LOTOU1\\.[0-9a-f-]{36}\\.[A-Za-z0-9_-]{43})$",
                "description": "Conteúdo do QR code: LOTOU2.<ticketId>.<assinatura Ed25519 de \"LOTOU2.<ticketId>\", base64url sem padding> (ADR 38). A portaria confere com a chave pública, inclusive no aparelho sem internet. Ingressos emitidos antes têm LOTOU1.<ticketId>.<HMAC-SHA256, base64url> (ADR 15), ainda aceitos."
              }
            }
          },
          "minItems": 1
        },
        "issuedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
