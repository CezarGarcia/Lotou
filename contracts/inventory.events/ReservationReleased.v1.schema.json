{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lotou:contracts:inventory.events:ReservationReleased:v1",
  "title": "ReservationReleased v1",
  "description": "Os ingressos da reserva voltaram à venda: liberada a pedido ou expirada. Tópico `inventory.events`, chave `showId`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "type",
    "version",
    "occurredAt",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "UUID v7 da mensagem; o consumidor o usa para ignorar repetições"
    },
    "type": {
      "const": "ReservationReleased"
    },
    "version": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reservationId",
        "showId",
        "sectorId",
        "lotId",
        "quantity",
        "seats",
        "reason",
        "releasedAt"
      ],
      "properties": {
        "reservationId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "showId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "sectorId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "lotId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "quantity": {
          "type": "integer",
          "minimum": 1
        },
        "seats": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "enum": [
            "RELEASED",
            "EXPIRED"
          ]
        },
        "releasedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
