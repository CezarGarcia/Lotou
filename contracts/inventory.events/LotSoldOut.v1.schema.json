{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lotou:contracts:inventory.events:LotSoldOut:v1",
  "title": "LotSoldOut v1",
  "description": "O lote esgotou. Tópico `inventory.events`, chave `showId`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "type",
    "version",
    "occurredAt",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "UUID v7 da mensagem; o consumidor o usa para ignorar repetições"
    },
    "type": {
      "const": "LotSoldOut"
    },
    "version": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "showId",
        "sectorId",
        "lotId",
        "soldOutAt"
      ],
      "properties": {
        "showId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "sectorId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "lotId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "soldOutAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
