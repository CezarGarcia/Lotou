{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lotou:contracts:shows.catalog:ShowUpdated:v1",
  "title": "ShowUpdated v1",
  "description": "O show mudou depois de publicado: dados, lotes ou status (abertura, encerramento, cancelamento). Tópico `shows.catalog`, chave `showId`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "type",
    "version",
    "occurredAt",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "UUID v7 da mensagem; o consumidor o usa para ignorar repetições"
    },
    "type": {
      "const": "ShowUpdated"
    },
    "version": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "showId",
        "version",
        "producerId",
        "status",
        "title",
        "artist",
        "startsAt",
        "doorsOpenAt",
        "salesStartAt",
        "salesEndAt",
        "highDemand",
        "venue",
        "sectors",
        "updatedAt"
      ],
      "properties": {
        "showId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "producerId": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "PUBLISHED",
            "ON_SALE",
            "SALES_CLOSED",
            "FINISHED",
            "CANCELLED"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "artist": {
          "type": "string",
          "minLength": 1
        },
        "startsAt": {
          "type": "string",
          "format": "date-time"
        },
        "doorsOpenAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "salesStartAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "salesEndAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "highDemand": {
          "type": "boolean"
        },
        "venue": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "name",
            "city",
            "state",
            "timezone"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "city": {
              "type": "string",
              "minLength": 1
            },
            "state": {
              "type": "string",
              "minLength": 1
            },
            "timezone": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "sectors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "kind",
              "capacity",
              "rows",
              "lots"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "GENERAL_ADMISSION",
                  "RESERVED_SEATING"
                ]
              },
              "capacity": {
                "type": "integer",
                "minimum": 1
              },
              "rows": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "label",
                    "seatCount"
                  ],
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "seatCount": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                }
              },
              "lots": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "name",
                    "priceCents",
                    "quantity",
                    "opensAt"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "priceCents": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "quantity": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "opensAt": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "format": "date-time"
                    }
                  }
                },
                "minItems": 1
              }
            }
          },
          "minItems": 1
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "description": "O show inteiro, como está depois da mudança. O consumidor guarda a versão mais alta e ignora as anteriores."
    }
  }
}
